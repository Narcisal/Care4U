GEMINI_API_KEY=your_api_key_here
TAVILY_API_KEY=your_api_key_here

# Optional: OpenAI fallback when Gemini is unavailable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ISAFE_MODEL=gemini-2.5-flash
MAGIC_MODEL=gemini-2.5-flash

# PostgreSQL (set DB_ENABLED=true to activate)
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aicaeru
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:password@localhost:5432/aicaeru

# TTS engines
BREEZYVOICE_URL=http://localhost:8080
XTTS_URL=http://localhost:8082
# Absolute path to restart_xtts.ps1; leave empty to disable auto-restart.
XTTS_RESTART_SCRIPT=

# STT
STT_POOL_SIZE=1
STT_MODEL_SIZE=small
STT_DEVICE=cpu

# Admin
CARE4U_DEMO_MODE=false
ADMIN_PASSWORD=care4u
ALLOWED_ELDER_IDS=W001,C001,L001,Z001
