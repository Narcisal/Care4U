GEMINI_API_KEY=your_api_key_here
TAVILY_API_KEY=

# Demo mode allows passwordless admin access from localhost only.
# Set false outside a local demo and configure ADMIN_PASSWORD or ADMIN_USERS.
CARE4U_DEMO_MODE=true
# Comma-separated frontend origins. Empty means "*" only in demo mode.
ALLOWED_ORIGINS=
# Role assigned to localhost passwordless access in demo mode.
CARE4U_DEMO_AUTH_ROLE=admin
# Elder IDs allowed to receive login PINs and bearer tokens.
ALLOWED_ELDER_IDS=W001,C001,L001
# Shared workers for parallel MagicAI and ISafe execution.
AGENT_EXECUTOR_WORKERS=4

DB_HOST=localhost
DB_ENABLED=false
DB_PORT=5433
DB_NAME=aicaeru
DB_USER=postgres
DB_PASSWORD=
DB_CONNECT_TIMEOUT=1
# Maximum PostgreSQL connections kept by the shared threaded pool.
DB_POOL_MAX=5

BREEZYVOICE_URL=http://localhost:8080
LUXTTS_URL=http://localhost:8081
XTTS_URL=http://localhost:8082

# Number of simultaneous STT workers; keep at 1 when hardware is limited.
# Set to the number of simultaneous speakers only when hardware permits.
# Whisper medium uses roughly 5 GB VRAM per worker, plus runtime/Breeze overhead.
STT_POOL_SIZE=1
STT_MODEL_SIZE=medium
STT_DEVICE=cuda

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_ROLE=admin
ADMIN_USERS=
